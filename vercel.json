{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/sync/catchr?days=3",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/sync/shopify",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/sync/orders?days=30",
      "schedule": "5,35 * * * *"
    },
    {
      "path": "/api/sync/catchr?days=28",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/sync/fba",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/sync/seo?days=30",
      "schedule": "45 */6 * * *"
    },
    {
      "path": "/api/sync/orders?days=90",
      "schedule": "40 6 * * *"
    },
    {
      "path": "/api/sync/searchterms?days=30",
      "schedule": "50 */6 * * *"
    }
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 300
    }
  }
}
